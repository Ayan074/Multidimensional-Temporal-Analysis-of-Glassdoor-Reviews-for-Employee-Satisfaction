# ─── Glassdoor Credentials ────────────────────────────────────────────────────
# Create a copy of this file named ".env" (without .example) and fill in your
# Glassdoor login credentials. This file is used by the scraper to log into
# Glassdoor and access full review text.
#
# IMPORTANT: Never commit your .env file to version control!
# ──────────────────────────────────────────────────────────────────────────────

GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
